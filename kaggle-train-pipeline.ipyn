{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":14594049,"sourceType":"datasetVersion","datasetId":9322198},{"sourceId":14600490,"sourceType":"datasetVersion","datasetId":9326065}],"dockerImageVersionId":31260,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"# 🛠️ 环境准备与权限校验 (Environment Setup & Verification)\n\n本阶段已完成工作空间初始化，并确保所有核心脚本具备执行权限。\n\n### 1. 文件完整性检查\n通过 `ls` 校验，确认以下核心组件已就绪：\n*   **Python 脚本**: `preprocess_data.py`, `monitor_training.py`, `test_inference.py`\n*   **配置中心**: `train_config.yaml`, `export_config.yaml`\n*   **说明文档**: `README.md`, `FILE_LIST.md`\n\n### 2. 权限自动化配置\n已通过 `os.stat` 模块对 Shell 脚本批量授予执行权限（Executable Permissions）：\n*   `setup.sh` (环境安装)\n*   `train.sh` (训练主程序)\n*   `run_all.sh` (全流程自动化)\n*   `cleanup.sh` & `export_and_quantize.sh`\n\n> **验证状态**: ✅ `rwxr-xr-x` 权限已生效。\n\n### 3. 结果汇总\n目前 `/kaggle/working` 目录已达到训练就绪状态（Ready-to-Train）。\n*注意：由于尚未生成模型，目前目录不含 `.json` 配置文件。*\n### 4. 环境依赖部署 (Dependency Deployment)\n已执行 `setup.sh` 脚本，完成以下初始化任务：\n*   **依赖安装**：根据 `requirements.txt` 配置 Python 运行环境。\n*   **路径初始化**：建立训练所需的临时目录和输出目录。\n*   **环境验证**：底层驱动与核心库（如 CUDA/PyTorch）适配完成。\n\n> **状态更新**：🚀 系统依赖已安装，环境已切换至“训练待命”模式。\n","metadata":{}},{"cell_type":"code","source":"import shutil\nimport os\n\n# 修正后的源目录和目标路径\nsrc = '/kaggle/input/kaggle-training-files-te' \ndst = '/kaggle/working/'\n\n# 将所有文件复制到 working 目录并赋予执行权限\nif os.path.exists(src):\n    for item in os.listdir(src):\n        s = os.path.join(src, item)\n        d = os.path.join(dst, item)\n        # 避免复制文件夹（如果是文件夹需用 copytree）\n        if os.path.isfile(s):\n            shutil.copy2(s, d)\n            # 如果是脚本，赋予执行权限\n            if item.endswith('.sh'):\n                os.chmod(d, 0o755)\n    print(\"✅ 脚本已成功迁移至 /kaggle/working 并配置执行权限\")\nelse:\n    print(f\"❌ 找不到源目录: {src}，请检查 Dataset 名称是否正确\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-24T09:59:20.509354Z","iopub.execute_input":"2026-01-24T09:59:20.509717Z","iopub.status.idle":"2026-01-24T09:59:20.586737Z","shell.execute_reply.started":"2026-01-24T09:59:20.509690Z","shell.execute_reply":"2026-01-24T09:59:20.586008Z"}},"outputs":[{"name":"stdout","text":"✅ 脚本已成功迁移至 /kaggle/working 并配置执行权限\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"import yaml\n\nconfig_path = '/kaggle/working/train_config.yaml'\nwith open(config_path, 'r') as f:\n    config = yaml.safe_load(f)\n\n# 修正 1：显存极限优化\nconfig['optim'] = 'adamw_bnb_8bit'  # 使用 8-bit 优化器，可节省约 2-4GB 显存\nconfig['lora_target'] = 'q_proj,v_proj' # 缩小 LoRA 范围，减少显存占用（原为 all 压力太大）\n\n# 修正 2：Qwen2-VL 视觉分辨率限制 (必须加在配置里或作为环境变量)\n# LLaMA Factory 识别的参数是 qwen2_vl_max_pixels\nconfig['qwen2_vl_max_pixels'] = 301056 # 限制在 600x500 分辨率左右，保命设置\n\nwith open(config_path, 'w') as f:\n    yaml.dump(config, f, default_flow_style=False)\n\nprint(\"✅ 已将优化器改为 8bit 并限制了视觉分辨率以适配 T4 16GB 显存。\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-24T10:02:13.521917Z","iopub.execute_input":"2026-01-24T10:02:13.522403Z","iopub.status.idle":"2026-01-24T10:02:13.583120Z","shell.execute_reply.started":"2026-01-24T10:02:13.522369Z","shell.execute_reply":"2026-01-24T10:02:13.581916Z"}},"outputs":[{"name":"stdout","text":"✅ 已将优化器改为 8bit 并限制了视觉分辨率以适配 T4 16GB 显存。\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"!python /kaggle/working/preprocess_data.py --check_only","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-24T10:07:36.198763Z","iopub.execute_input":"2026-01-24T10:07:36.200090Z","iopub.status.idle":"2026-01-24T10:07:36.701356Z","shell.execute_reply.started":"2026-01-24T10:07:36.200057Z","shell.execute_reply":"2026-01-24T10:07:36.700428Z"}},"outputs":[{"name":"stdout","text":"\n============================================================\nQwen2-VL 数据预处理启动\n============================================================\n\n============================================================\n处理文件: /kaggle/input/fitness-rehab-vlm/train.json\n============================================================\n✓ 加载了 45 个样本\n\n============================================================\n处理完成统计:\n  ✓ 有效样本: 45\n  ✗ 无效样本: 0\n  → 保存路径: /kaggle/temp/train.json\n============================================================\n\n✓ 第一个样本预览:\n{\n  \"id\": \"lunge_side_standard_0001\",\n  \"image\": \"images/lunge/lunge__side__standard__none__0001.jpg\",\n  \"action\": \"lunge\",\n  \"view\": \"side\",\n  \"sample_type\": \"standard\",\n  \"error_type\": \"none\",\n  \"conversations\": [\n    {\n      \"from\": \"human\",\n      \"value\": \"<image>\\n请检查我的弓步蹲动作。\"\n    },\n    {\n      \"from\": \"gpt\",\n      \"value\": \"【推理过程】：\\n1. 检测下肢力线：侧观前后腿膝关节均呈 90 度夹角。\\n2. 判定代偿：躯干垂直地面，脊柱中立，重心稳定分布。\\n3. 解决策略：维持现有幅度，确保膝盖投影未超脚尖。\\n\\n【判定结果】：\\n标准动作。力线理想，作为全体型训练基准。\"\n    }\n  ],\n  \"images\": [\n    \"/kaggle/...\n\n============================================================\n处理文件: /kaggle/input/fitness-rehab-vlm/val.json\n============================================================\n✓ 加载了 9 个样本\n\n============================================================\n处理完成统计:\n  ✓ 有效样本: 9\n  ✗ 无效样本: 0\n  → 保存路径: /kaggle/temp/val.json\n============================================================\n\n✓ 第一个样本预览:\n{\n  \"id\": \"squat__side__standard__none__0016\",\n  \"image\": \"images/squat/squat__side__standard__none__0016.jpg\",\n  \"conversations\": [\n    {\n      \"from\": \"human\",\n      \"value\": \"<image>\\n请检查我的深蹲动作。\"\n    },\n    {\n      \"from\": \"gpt\",\n      \"value\": \"【推理过程】:\\n1. 侧面观察髋、膝、踝三点形成稳定垂直力线。\\n2. 躯干直立，脊柱中立，无圆背。\\n3. 大腿下蹲接近平行地面。\\n【判定结果】:\\n标准深蹲，可作为侧面正确样本。\"\n    }\n  ],\n  \"action\": \"squat\",\n  \"view\": \"side\",\n  \"sample_type\": \"standard\",\n  \"error_type\": \"none\",\n  \"images\": [\n    \"/kaggle/input/fitness-rehab-vlm/im...\n\n============================================================\n✓ 数据预处理全部完成！\n✓ 输出目录: /kaggle/temp\n============================================================\n\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"import yaml\n\nconfig_path = '/kaggle/working/train_config.yaml'\nwith open(config_path, 'r') as f:\n    config = yaml.safe_load(f)\n\n# --- 冒烟测试专用修改 ---\nconfig['device_map'] = 'cpu'      # 强制指定设备为 CPU\nconfig['fp16'] = False            # CPU 不支持 FP16 混合精度\nconfig['bf16'] = False\nconfig['max_steps'] = 2           # 跑 2 步就行，验证能跑通就行\nconfig['gradient_checkpointing'] = False # CPU 不需要此优化\n\nwith open(config_path, 'w') as f:\n    yaml.dump(config, f, default_flow_style=False)\n\nprint(\"✅ 已切换为 CPU 冒烟测试模式（max_steps=2）\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-24T10:09:54.855844Z","iopub.execute_input":"2026-01-24T10:09:54.856255Z","iopub.status.idle":"2026-01-24T10:09:54.874089Z","shell.execute_reply.started":"2026-01-24T10:09:54.856216Z","shell.execute_reply":"2026-01-24T10:09:54.873103Z"}},"outputs":[{"name":"stdout","text":"✅ 已切换为 CPU 冒烟测试模式（max_steps=2）\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"!bash /kaggle/working/setup.sh","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-24T10:16:50.742777Z","iopub.execute_input":"2026-01-24T10:16:50.743194Z","iopub.status.idle":"2026-01-24T10:17:19.528412Z","shell.execute_reply.started":"2026-01-24T10:16:50.743164Z","shell.execute_reply":"2026-01-24T10:17:19.527402Z"}},"outputs":[{"name":"stdout","text":"==========================================\n环境初始化开始 (T4×2 GPU 配置)\n==========================================\n[1/6] 配置环境变量...\n✓ 环境变量配置完成\n[2/6] 检查 GPU 配置...\n/kaggle/working/setup.sh: line 42: