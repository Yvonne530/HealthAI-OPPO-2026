, 'r') as f:\n    config = yaml.safe_load(f)\n\n# 1. 禁用评估策略，防止报错\nconfig['eval_strategy'] = 'no' \nconfig['eval_steps'] = None      # 移除评估步数\nif 'val_size' not in config:\n    config['val_size'] = 0.0     # 明确告诉系统不需要验证集分割\n\n# 2. 确保 dataset 只包含训练集\nconfig['dataset'] = 'rehab_train'\n\nwith open(config_path, 'w') as f:\n    yaml.dump(config, f, default_flow_style=False)\n\nprint(\"✅ 已关闭评估模式。现在可以重新运行冒烟测试了！\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-24T10:24:26.861992Z","iopub.execute_input":"2026-01-24T10:24:26.862401Z","iopub.status.idle":"2026-01-24T10:24:26.880304Z","shell.execute_reply.started":"2026-01-24T10:24:26.862362Z","shell.execute_reply":"2026-01-24T10:24:26.878702Z"}},"outputs":[{"name":"stdout","text":"✅ 已关闭评估模式。现在可以重新运行冒烟测试了！\n","output_type":"stream"}],"execution_count":15},{"cell_type":"code","source":"import yaml\n\nconfig_path = '/kaggle/working/train_config.yaml'\nwith open(config_path, 'r') as f:\n    config = yaml.safe_load(f)\n\n# 1. 重新设置验证集参数\nconfig['eval_strategy'] = 'steps'      # 恢复按步数评估\nconfig['eval_steps'] = 100             # 每 100 步评估一次\nconfig['val_size'] = 0.1               # 如果你没有独立的验证集文件，这会自动切分 10% 数据\n# 如果你有独立验证集，请确保 dataset_info.json 里有 rehab_val，并使用下行：\n# config['eval_dataset'] = 'rehab_val' \n\n# 2. 恢复 GPU 训练必须的参数\nconfig['fp16'] = True\nconfig['optim'] = 'adamw_bnb_8bit'\nconfig['max_steps'] = 1000             # 设为你最终想要的步数\n\nwith open(config_path, 'w') as f:\n    yaml.dump(config, f, default_flow_style=False)\n\nprint(\"✅ 已成功修复验证集配置并切回 GPU 模式！\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-24T10:26:51.024047Z","iopub.execute_input":"2026-01-24T10:26:51.024622Z","iopub.status.idle":"2026-01-24T10:26:51.040484Z","shell.execute_reply.started":"2026-01-24T10:26:51.024551Z","shell.execute_reply":"2026-01-24T10:26:51.038676Z"}},"outputs":[{"name":"stdout","text":"✅ 已成功修复验证集配置并切回 GPU 模式！\n","output_type":"stream"}],"execution_count":17},{"cell_type":"code","source":"import yaml\n\nconfig_path = '/kaggle/working/train_config.yaml'\n\nwith open(config_path, 'r') as f:\n    config = yaml.safe_load(f)\n\n# --- 核心：还原并优化 T4 双卡配置 ---\nconfig['fp16'] = True                           # 开启 T4 混合精度加速\nconfig['bf16'] = False                          # T4 不支持 BF16\nconfig['gradient_checkpointing'] = True         # 节省显存核心开关\nconfig['optim'] = 'adamw_bnb_8bit'              # 8-bit 优化器节省显存\n\n# --- 移除 CPU 限制 ---\nif 'device_map' in config:\n    del config['device_map']                    # 让系统自动分配 GPU\n\n# --- 设定正式训练步数 ---\n# 建议先设为 500 或 1000，或根据 epoch 自动计算\nconfig['max_steps'] = 500                       \nconfig['save_steps'] = 100                      # 每 100 步存一次\nconfig['save_total_limit'] = 1                  # 关键：只留 1 个文件防止磁盘爆满\n\n# --- 视觉分辨率保护 (保命设置) ---\nconfig['qwen2_vl_max_pixels'] = 301056          # 限制图片分辨率\n\nwith open(config_path, 'w') as f:\n    yaml.dump(config, f, default_flow_style=False)\n\nprint(\"🚀 配置已成功还原！\")\nprint(\"1. 已开启 FP16 和 8-bit 优化器\")\nprint(\"2. 已限制 save_total_limit 为 1\")\nprint(\"3. 已将 max_steps 设为 500\")\nprint(\"现在你可以切换回 GPU T4 x2 环境并运行 train.sh 了。\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-24T10:27:37.876344Z","iopub.execute_input":"2026-01-24T10:27:37.876754Z","iopub.status.idle":"2026-01-24T10:27:37.893589Z","shell.execute_reply.started":"2026-01-24T10:27:37.876714Z","shell.execute_reply":"2026-01-24T10:27:37.892008Z"}},"outputs":[{"name":"stdout","text":"🚀 配置已成功还原！\n1. 已开启 FP16 和 8-bit 优化器\n2. 已限制 save_total_limit 为 1\n3. 已将 max_steps 设为 500\n现在你可以切换回 GPU T4 x2 环境并运行 train.sh 了。\n","output_type":"stream"}],"execution_count":18}]}