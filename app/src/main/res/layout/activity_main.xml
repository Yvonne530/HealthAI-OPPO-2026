<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 主内容区域 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- FrameLayout 用于切换视图 -->

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="0dp" />

        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintBottom_toTopOf="@id/bottomNav">

            <!-- 聊天视图 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chatView"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewChat"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:padding="8dp"
                    android:clipToPadding="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/inputLayout" />

                <!-- 输入区域 -->
                <LinearLayout
                    android:id="@+id/inputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:background="@drawable/bg_surface"
                    android:elevation="4dp"
                    app:layout_constraintBottom_toBottomOf="parent">

            <!-- 图片缩略图区域 -->
            <FrameLayout
                android:id="@+id/imageSection"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/image_description"
                    android:scaleType="centerCrop"
                    android:background="#F0F0F0" />

                <ImageButton
                    android:id="@+id/buttonRemoveImage"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="删除图片"
                    android:layout_gravity="top|end"
                    android:background="#E53935"
                    android:tint="@android:color/white" />

            </FrameLayout>

            <EditText
                android:id="@+id/editTextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="输入消息..."
                android:maxLines="4"
                android:inputType="textMultiLine"
                android:layout_marginEnd="8dp"
                android:layout_gravity="center_vertical" />

            <ImageButton
                android:id="@+id/buttonAddImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="添加图片"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_gravity="center_vertical" />

            <Button
                    android:id="@+id/buttonSendMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="发送"
                    android:layout_gravity="center_vertical" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 历史记录视图 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/historyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewHistory"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/buttonNewChat" />

                <Button
                    android:id="@+id/buttonNewChat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="新建对话"
                    android:backgroundTint="#4CAF50"
                    android:layout_margin="16dp"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 模型视图 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/modelsView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 模型区域 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="模型"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="8dp" />

                        <TextView
                            android:id="@+id/textViewCurrentModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="未加载模型"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="4dp" />

                        <TextView
                            android:id="@+id/textViewModelSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp" />

                        <Button
                            android:id="@+id/buttonImportModelFromView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="选择/替换模型文件"
                            android:backgroundTint="#4CAF50"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="16dp" />

                        <!-- 多模态区域 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="多模态"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="8dp" />

                        <TextView
                            android:id="@+id/textViewCurrentMmproj"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="未加载多模态文件"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="4dp" />

                        <TextView
                            android:id="@+id/textViewMmprojSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp" />

                        <Button
                            android:id="@+id/buttonImportMmprojFromView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="选择/替换多模态文件"
                            android:backgroundTint="#9C27B0"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="16dp" />

                        <!-- 配置区域 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="配置"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="注意：只能配置一个模型和一个多模态文件。导入新文件会自动替换旧文件。"
                            android:textSize="12sp"
                            android:textColor="#FF9800"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="最大生成Token数"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:paddingBottom="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingBottom="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="单次生成的最大token数"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />

                                <EditText
                                    android:id="@+id/editTextMaxTokens"
                                    android:layout_width="80dp"
                                    android:layout_height="wrap_content"
                                    android:text="512"
                                    android:textSize="12sp"
                                    android:inputType="number"
                                    android:textAlignment="center"
                                    android:background="#80FFFFFF"
                                    android:padding="4dp"
                                    android:maxLines="1" />

                            </LinearLayout>

                            <SeekBar
                                android:id="@+id/seekBarMaxTokens"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="4096"
                                android:progress="512"
                                android:paddingBottom="12dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="上下文大小"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:paddingBottom="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingBottom="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="模型上下文窗口大小"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />

                                <EditText
                                    android:id="@+id/editTextContextSize"
                                    android:layout_width="80dp"
                                    android:layout_height="wrap_content"
                                    android:text="8192"
                                    android:textSize="12sp"
                                    android:inputType="number"
                                    android:textAlignment="center"
                                    android:background="#80FFFFFF"
                                    android:padding="4dp"
                                    android:maxLines="1" />

                            </LinearLayout>

                            <SeekBar
                                android:id="@+id/seekBarContextSize"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="32768"
                                android:progress="8192"
                                android:paddingBottom="12dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="温度 (Temperature)"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:paddingBottom="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingBottom="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="控制输出的随机性 (0.0-2.0)"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />

                                <EditText
                                    android:id="@+id/editTextTemperature"
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:text="0.7"
                                    android:textSize="12sp"
                                    android:inputType="numberDecimal"
                                    android:textAlignment="center"
                                    android:background="#80FFFFFF"
                                    android:padding="4dp"
                                    android:maxLines="1" />

                            </LinearLayout>

                            <SeekBar
                                android:id="@+id/seekBarTemperature"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="200"
                                android:progress="70"
                                android:paddingBottom="12dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Top-P (Nucleus Sampling)"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:paddingBottom="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingBottom="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="限制词汇累积概率 (0.0-1.0)"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />

                                <EditText
                                    android:id="@+id/editTextTopP"
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:text="0.9"
                                    android:textSize="12sp"
                                    android:inputType="numberDecimal"
                                    android:textAlignment="center"
                                    android:background="#80FFFFFF"
                                    android:padding="4dp"
                                    android:maxLines="1" />

                            </LinearLayout>

                            <SeekBar
                                android:id="@+id/seekBarTopP"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="100"
                                android:progress="90"
                                android:paddingBottom="12dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Top-K"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:paddingBottom="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingBottom="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="保留最高概率的K个token"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />

                                <EditText
                                    android:id="@+id/editTextTopK"
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:text="40"
                                    android:textSize="12sp"
                                    android:inputType="number"
                                    android:textAlignment="center"
                                    android:background="#80FFFFFF"
                                    android:padding="4dp"
                                    android:maxLines="1" />

                            </LinearLayout>

                            <SeekBar
                                android:id="@+id/seekBarTopK"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="100"
                                android:progress="40"
                                android:paddingBottom="8dp" />

                        </LinearLayout>

                        <Button
                            android:id="@+id/buttonReloadModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="重新加载模型"
                            android:backgroundTint="#FF5722"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="注意：修改参数后需要重新加载模型才能生效"
                            android:textSize="11sp"
                            android:textColor="#FF9800"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp" />

                    </LinearLayout>
                </ScrollView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 识别视图 - 动作识别 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/recognitionView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViewRecognitionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="动作识别"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:padding="16dp"
                    app:layout_constraintTop_toTopOf="parent" />

                <ScrollView
                    android:id="@+id/scrollViewRecognition"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toBottomOf="@id/textViewRecognitionTitle"
                    app:layout_constraintBottom_toTopOf="@id/buttonsRecognitionLayout">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="选择或拍摄图片，识别人物动作是否规范"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:paddingBottom="16dp" />

                        <FrameLayout
                            android:id="@+id/recognitionImageSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#F0F0F0"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <!-- 原图显示区域已隐藏 -->
                                <FrameLayout
                                    android:id="@+id/frameLayoutOriginal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone">

                                    <ImageView
                                        android:id="@+id/imageViewOriginal"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:adjustViewBounds="true"
                                        android:scaleType="fitCenter" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="原图"
                                        android:textColor="#FFFFFF"
                                        android:background="#80000000"
                                        android:padding="4dp"
                                        android:layout_gravity="top|start"
                                        android:layout_margin="4dp" />
                                </FrameLayout>

                                <!-- 分隔线已隐藏 -->
                                <View
                                    android:id="@+id/viewDivider"
                                    android:layout_width="match_parent"
                                    android:layout_height="2dp"
                                    android:background="#CCCCCC"
                                    android:visibility="gone" />

                                <!-- 裁剪+绘制图显示在下半部分 -->
                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <ImageView
                                        android:id="@+id/imageViewRecognition"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:adjustViewBounds="true"
                                        android:scaleType="fitCenter" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="骨骼区域"
                                        android:textColor="#FFFFFF"
                                        android:background="#80000000"
                                        android:padding="4dp"
                                        android:layout_gravity="top|start"
                                        android:layout_margin="4dp" />
                                </FrameLayout>
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/buttonRemoveRecognitionImage"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                android:contentDescription="删除图片"
                                android:layout_gravity="top|end"
                                android:layout_margin="8dp"
                                android:background="#E53935"
                                android:tint="@android:color/white" />

                        </FrameLayout>

                        <!-- 实时摄像头捕获预览 -->
                        <FrameLayout
                            android:id="@+id/cameraPreviewSection"
                            android:layout_width="match_parent"
                            android:layout_height="400dp"
                            android:background="#F0F0F0"
                            android:visibility="gone">

                            <androidx.camera.view.PreviewView
                                android:id="@+id/previewView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <!-- 骨骼检测覆盖层 -->
                            <ImageView
                                android:id="@+id/cameraPoseOverlay"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop" />

                            <!-- 控制按钮区域 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center"
                                android:layout_marginBottom="16dp"
                                android:orientation="horizontal"
                                android:gravity="center">

                                <Button
                                    android:id="@+id/buttonSwitchCamera"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="切换摄像头"
                                    android:backgroundTint="#2196F3"
                                    android:textSize="12sp"
                                    android:layout_marginEnd="8dp" />

                                <Button
                                    android:id="@+id/buttonStopCameraCapture"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="停止"
                                    android:backgroundTint="#E53935"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </FrameLayout>

                        <TextView
                            android:id="@+id/textViewRecognitionPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="300dp"
                            android:text="点击下方按钮选择或拍摄图片"
                            android:textSize="14sp"
                            android:textColor="#999999"
                            android:gravity="center"
                            android:background="#F5F5F5"
                            android:visibility="visible" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="识别结果"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:paddingTop="16dp"
                            android:paddingBottom="8dp" />

                        <TextView
                            android:id="@+id/textViewRecognitionResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="等待识别..."
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:padding="12dp"
                            android:background="@drawable/bg_surface"
                            android:minHeight="100dp"
                            android:textIsSelectable="true"
                            android:longClickable="true" />

                    </LinearLayout>
                </ScrollView>

                <LinearLayout
                    android:id="@+id/buttonsRecognitionLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="16dp"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <Button
                            android:id="@+id/buttonSelectRecognitionImage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="选择图片"
                            android:backgroundTint="#2196F3"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/buttonCaptureRecognitionImage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="拍摄图片"
                            android:backgroundTint="#4CAF50" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonStartCameraCapture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="实时摄像头"
                        android:backgroundTint="#673AB7"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/buttonStartRecognitionAnalysis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="开始分析"
                        android:backgroundTint="#FF9800"
                        android:textSize="16sp"
                        android:enabled="false" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>

        <!-- 底部导航栏 -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav_menu"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 侧边栏 -->
    <ScrollView
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_surface">

        <LinearLayout
            android:id="@+id/drawerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="用户设置"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/imageViewUserAvatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_avatar"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textViewUserNickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="用户"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewTapToEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击头像或昵称修改"
                        android:textSize="11sp"
                        android:textColor="#999999" />

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/buttonImportMmproj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择/替换多模态文件"
                android:backgroundTint="#9C27B0"
                android:paddingBottom="16dp" />

            <Button
                android:id="@+id/buttonSetSystemPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设置系统提示词"
                android:backgroundTint="#2196F3"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/textViewSystemPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="系统提示词: 你是一个有用的助手。"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:padding="8dp"
                android:paddingBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="联网功能"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_switch_item"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启用联网搜索"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <Switch
                    android:id="@+id/switchNetwork"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用后AI可搜索最新信息"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="界面设置"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_switch_item"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="深色模式"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <Switch
                    android:id="@+id/switchDarkMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="切换深色/浅色主题"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp" />

            <Button
                android:id="@+id/buttonClearHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="清空对话历史"
                android:backgroundTint="#FF9800"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/textViewModelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模型状态: 未加载"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:padding="8dp" />

        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>