<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.healthai.ankle">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:name=".RehabApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_cat_mascot"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_cat_mascot"
        android:supportsRtl="true"
        android:theme="@style/Theme.RehabGuardian"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!-- LAUNCHER: fluffy cat splash -->
        <activity
            android:name=".ui.CatSplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main camera + inference screen -->
        <activity
            android:name=".ui.RehabGuardianActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustPan" />

        <!-- Session history + replay -->
        <activity
            android:name=".ui.SessionHistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Best frame detail -->
        <activity
            android:name=".ui.BestFrameActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>
</manifest>